#!/bin/bash

: <<'HEADER'

DUNE FD2-VD SUPERNOVA: MARLEY GEN -> Geant4 -> DetSim

To run this script with justIN:

1) setup justin
2) justin time
3) justin get-token

USERF=$USER
FNALURL='https://fndcadoor.fnal.gov:2880/dune/scratch/users'

justin simple-workflow \
  --monte-carlo 10 \
  --jobscript-git GBotogoske/my_grid/my_submit_snv.jobscript:main \
  --env NUM_EVENTS=10 \
  --scope usertests --lifetime-days 2 \
  --rss-mib 24000 \
  --output-pattern "snv_detsim_*.root:${FNALURL}/${USERF}"

To test with 2 events:

justin-test-jobscript \
  --monte-carlo 1 \
  --jobscript my_submit_snv.jobscript \
  --env NUM_EVENTS=2

To stop a running workflow:

justin finish-workflow --workflow-id <ID_DO_WORKFLOW>

To see the output files:
/pnfs/dune/scratch/users/<USER>

Notes:
- 100 Monte Carlo units x 100 events = 10,000 events if all jobs succeed.
- The FHiCL files below are standard dunesw FHiCLs (no input tarball needed).
- Check that the FHiCL filenames are present in dunesw v10_26_00d00.
- The output pattern saves only the DetSim ROOT file to dCache.
- GEN uses flat nu_e CC interactions, not a time-dependent supernova burst.
- Verify independent random seeds across work units before large-scale production.
- Update/push this file to the Git repository before submitting with --jobscript-git.

HEADER

# Set defaults
FCL_FILE_GEN=${FCL_FILE_GEN:-prodmarley_nue_cc_flat_dunevd10kt_1x8x14_3view_30deg.fcl}
FCL_FILE_G4=${FCL_FILE_G4:-standard_g4_dunevd10kt_1x8x14_3view_30deg.fcl}
FCL_FILE_DETSIM=${FCL_FILE_DETSIM:-standard_detsim_dunevd10kt_1x8x14_3view_30deg.fcl}
DUNE_VERSION=${DUNE_VERSION:-v10_26_00d00}
DUNE_QUALIFIER=${DUNE_QUALIFIER:-e26:prof}
NUM_EVENTS=${NUM_EVENTS:-100}

# Get justIN Monte Carlo work unit
DID_PFN_RSE=`$JUSTIN_PATH/justin-get-file`
pfn=`echo "$DID_PFN_RSE" | cut -f2 -d' '`

if [ -z "$pfn" ]; then
  echo 'ERROR: no PFN returned by justin-get-file' >&2
  exit 1
fi

first_file="snv_gen_${pfn}.root"
second_file="snv_g4_${pfn}.root"
third_file="snv_detsim_${pfn}.root"

# Setup DUNE environment
source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh
setup dunesw "$DUNE_VERSION" -q "$DUNE_QUALIFIER"
setupExit=$?
if [ "$setupExit" -ne 0 ]; then
  echo "ERROR: setup dunesw failed (exit $setupExit)" >&2
  exit "$setupExit"
fi

# Run LArSoft
(
  # Keep XRootD preload from the working script when available
  if [ -n "${XROOTD_LIB:-}" ] && [ -f "$XROOTD_LIB/libXrdPosixPreload.so" ]; then
    export LD_PRELOAD="$XROOTD_LIB/libXrdPosixPreload.so"
    echo "$LD_PRELOAD"
  fi

  echo "PFN: $pfn"
  echo "Events per work unit: $NUM_EVENTS"

  echo '===== MARLEY GEN ====='
  lar -c "$FCL_FILE_GEN" -o "$first_file" -n "$NUM_EVENTS" || exit $?

  echo '===== Geant4 ====='
  lar -c "$FCL_FILE_G4" -s "$first_file" -o "$second_file" || exit $?

  echo '===== DetSim ====='
  lar -c "$FCL_FILE_DETSIM" -s "$second_file" -o "$third_file" || exit $?
)

larExit=$?
echo "lar exit code $larExit"
echo "pfn $pfn"
echo "outfile $third_file"

if [ "$larExit" -eq 0 ] && [ -s "$third_file" ]; then
  echo "$pfn" > justin-processed-pfns.txt
  jobscriptExit=0
else
  jobscriptExit=1
fi

exit "$jobscriptExit"
