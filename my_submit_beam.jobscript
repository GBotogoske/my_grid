#!/bin/bash

: <<'EOF'

============================================================
CREATE TARBALL
============================================================

tar -cvf my_fcl.tar \
    gen_beam.fcl \
    gen_cosmics_g4.fcl \
    gen_cosmics_detsim.fcl

setup justin
justin time
justin get-token

INPUT_TAR_DIR_LOCAL=`justin-cvmfs-upload my_fcl.tar`

# Wait a little and check:
ls -l "$INPUT_TAR_DIR_LOCAL"


============================================================
SUBMIT
============================================================

USERF=$USER
FNALURL='https://fndcadoor.fnal.gov:2880/dune/scratch/users'

MQL_QUERY="files from ehn1-beam-np04:ehn1-beam-np04__np04beam_2025__root-tuple__v3.06__g4beamline__5GeV_v1_official limit 100"

justin simple-workflow \
  --mql "$MQL_QUERY" \
  --jobscript-git GBotogoske/my_grid/my_submit_beam.jobscript:main \
  --env NUM_EVENTS=10 \
  --env INPUT_TAR_DIR_LOCAL="$INPUT_TAR_DIR_LOCAL" \
  --max-distance 30 \
  --scope usertests \
  --lifetime-days 2 \
  --rss-mib 24000 \
  --output-pattern "beam_detsim_*.root:${FNALURL}/${USERF}"


============================================================
TEST WITH ONE INPUT FILE
============================================================

MQL_TEST="files from ehn1-beam-np04:ehn1-beam-np04__np04beam_2025__root-tuple__v3.06__g4beamline__5GeV_v1_official limit 1"

justin-test-jobscript \
  --mql "$MQL_TEST" \
  --jobscript my_beam.jobscript \
  --env NUM_EVENTS=10 \
  --env INPUT_TAR_DIR_LOCAL="$INPUT_TAR_DIR_LOCAL"


============================================================
STOP WORKFLOW
============================================================

justin finish-workflow --workflow-id <ID_DO_WORKFLOW>


============================================================
OUTPUT FILES
============================================================

/pnfs/dune/scratch/users/<USER>

EOF


# ============================================================
# FCL FILES
# ============================================================

FCL_FILE_GEN="$INPUT_TAR_DIR_LOCAL/gen_beam.fcl"
FCL_FILE_G4="$INPUT_TAR_DIR_LOCAL/gen_cosmics_g4.fcl"
FCL_FILE_DETSIM="$INPUT_TAR_DIR_LOCAL/gen_cosmics_detsim.fcl"


# ============================================================
# SOFTWARE VERSION
# ============================================================

DUNE_VERSION=${DUNE_VERSION:-v10_08_00d00}
DUNE_QUALIFIER=${DUNE_QUALIFIER:-e26:prof}


# ============================================================
# SETUP DUNE
# ============================================================

source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh

setup dunesw "$DUNE_VERSION" -q "$DUNE_QUALIFIER"

setup_exit=$?

if [ "$setup_exit" != 0 ]; then
    echo "ERROR setting up dunesw $DUNE_VERSION"
    exit "$setup_exit"
fi

echo "========================================="
echo "DUNE_VERSION   = $DUNE_VERSION"
echo "DUNE_QUALIFIER = $DUNE_QUALIFIER"
echo "========================================="


# ============================================================
# GET ONE H4 INPUT FILE FROM JUSTIN
# ============================================================

DID_PFN_RSE=`$JUSTIN_PATH/justin-get-file`

if [ -z "$DID_PFN_RSE" ]; then
    echo "Could not get input H4 file"
    exit 0
fi


did=`echo "$DID_PFN_RSE" | cut -f1 -d' '`
pfn=`echo "$DID_PFN_RSE" | cut -f2 -d' '`
rse=`echo "$DID_PFN_RSE" | cut -f3 -d' '`

name_only=`echo "$did" | cut -f2 -d':'`


echo "========================================="
echo "H4 INPUT FILE"
echo "========================================="
echo "DID       = $did"
echo "PFN       = $pfn"
echo "RSE       = $rse"
echo "NAME      = $name_only"
echo "========================================="


# ============================================================
# NUMBER OF EVENTS
# ============================================================

NUM_EVENTS=${NUM_EVENTS:-10}

echo "NUM_EVENTS = $NUM_EVENTS"


# ============================================================
# UNIQUE JOB IDENTIFIER
# ============================================================

jobid=`echo "${JUSTIN_JOBSUB_ID:-1}" | cut -f1 -d'@' | sed -e "s/\./_/"`
stageid=${JUSTIN_STAGE_ID:-1}

echo "========================================="
echo "JUSTIN JOB"
echo "========================================="
echo "JOB ID   = $jobid"
echo "STAGE ID = $stageid"
echo "========================================="


# ============================================================
# OUTPUT FILE NAMES
# ============================================================

first_file="beam_gen_${jobid}.root"
second_file="beam_g4_${jobid}.root"
third_file="beam_detsim_${jobid}.root"


echo "GEN output    = $first_file"
echo "G4 output     = $second_file"
echo "DETSIM output = $third_file"


# ============================================================
# XROOTD
# ============================================================

if [ -n "${XROOTD_LIB:-}" ] && \
   [ -f "${XROOTD_LIB}/libXrdPosixPreload.so" ]; then

    export LD_PRELOAD="${XROOTD_LIB}/libXrdPosixPreload.so"

    echo "LD_PRELOAD = $LD_PRELOAD"
else
    echo "XRootD preload library not found; continuing without LD_PRELOAD"
fi


# ============================================================
# 1 - BEAM GENERATION
# ============================================================

echo ""
echo "========================================"
echo "1 - BEAM GENERATION"
echo "========================================"
echo "H4 input = $pfn"
echo "Events   = $NUM_EVENTS"
echo "========================================"

lar \
    -n "$NUM_EVENTS" \
    -c "$FCL_FILE_GEN" \
    -o "$first_file" \
    "$pfn"

larReturnCode=$?

echo "GEN lar return code = $larReturnCode"

if [ "$larReturnCode" != 0 ]; then
    echo "ERROR during beam generation"
    exit "$larReturnCode"
fi


# ============================================================
# 2 - G4
# ============================================================

echo ""
echo "========================================"
echo "2 - G4"
echo "========================================"
echo "Input  = $first_file"
echo "Output = $second_file"
echo "========================================"

lar \
    -c "$FCL_FILE_G4" \
    -o "$second_file" \
    "$first_file"

larReturnCode=$?

echo "G4 lar return code = $larReturnCode"

if [ "$larReturnCode" != 0 ]; then
    echo "ERROR during G4"
    exit "$larReturnCode"
fi


# ============================================================
# 3 - DETSIM
# ============================================================

echo ""
echo "========================================"
echo "3 - DETSIM"
echo "========================================"
echo "Input  = $second_file"
echo "Output = $third_file"
echo "========================================"

lar \
    -c "$FCL_FILE_DETSIM" \
    -o "$third_file" \
    "$second_file"

larReturnCode=$?

echo "DETSIM lar return code = $larReturnCode"

if [ "$larReturnCode" != 0 ]; then
    echo "ERROR during DETSIM"
    exit "$larReturnCode"
fi


# ============================================================
# TELL JUSTIN THAT INPUT WAS PROCESSED
# ============================================================

echo "$pfn" > justin-processed-pfns.txt


# ============================================================
# FINAL INFORMATION
# ============================================================

echo ""
echo "========================================"
echo "JOB FINISHED SUCCESSFULLY"
echo "========================================"
echo "Input DID     = $did"
echo "Input H4      = $pfn"
echo "Input RSE     = $rse"
echo "GEN output    = $first_file"
echo "G4 output     = $second_file"
echo "DETSIM output = $third_file"
echo "========================================"

ls -lh

exit 0
